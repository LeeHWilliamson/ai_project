'''
NOTES
This model represents the underlying patient state, it does not include any information about how anything is documented within an EHR,
encounter information is documented only as much as needed to help predict patient trajectory.
So, we don't distinguish between what a patient is experiencing and what is documented. We do not assume all conditions that a patient exhibits at any given time are caught at an encounter that takes place at that time,
nor do we assume none of them are.
fixed contains all information that is not expected to change during a patient's life
active contains all information relating to anything that can change with time
encounters is a reference of all encounters the patient has had in their lifetime, attended means the encounter took place, missed means the encounter was never attended, scheduled means the encounter is set to take place at a later date
these 3 categories are mutually exclusive.
week_x represents a snapshot of active for that given week and entries for any encounters
'''
{
  "fixed" : {
    "id" : str,
    "first_name": str,
    "last_name": str,
    "birth_date": str,
    "birth_sex": str,
    "race": str,
    "ethnicity": str,
    "blood_type": str,
    "family_history": [str],
  },
  "state" : {
    "physical": {"measurements" : {
      "weight": float,
      "waist_size": float,
      "thirst": int, #range == 1 to 5, 3 == baseline based on age, size, activity, etc,
      "urintation": int, measures weekly frequency,
      "hdl_cholesterol": float,
      "triglycerides": float,
      "blood_pressure": float,
      "visual_acuity": float,
      "hearing": float,
    },
    "attributes": {
      "gestational_diabetes": bool,
      "birthed_child_over_9_pounds": bool,
      "polycystic_ovary_syndrome": bool,
      "pregnant": bool,
      "conditions" : [{}],
      "symptoms" : [{"name" : str, "cause" : [str], "severity": int}], ##symptoms are things like nausea and diahrrhea that can have multiple causes (medicines, diabetes, complications, no clear cause)
    }},
    "care" : { "measurements": {},
      "attributes": {
        "insulin_monitoring": [{"device": str, "frequency": float}],
        "medications": ["name": str, "dosage": float, "units" : str, "frequency": float, "frequency_units": str, "encounter": str, "active_side_effects": [str]],
        "insulin_therapy": [{"type" : str, "dosage": float, "frequency": float}],
        "careplans" : []
      }
    },
    "behavioral" : { 
      "measurements" : {
        "minutes_weekly_exercise": float,
        "weekly_diet": {"avg_daily_calories" : int, "percent_carbs": float, "total_carbs": int, "percent_fiber": float, "total_fiber": int},
        "social_activity": int, range 1-10 with 5 being baseline
        "avg_nightly_sleep": float,
      },
    "attributes" : {
      "work_activity": enum [low, medium, high] low = white collar, medium = school teacher / plumber, high = waiter
    }
  },
    "socio_economic" : {
      "measurements" : {
        "income": float
      },
      "attributes" : {
        "primary_insurance" : bool,
        "primary_insurance_source": enum [self, medicare, medicade, employer],
        "primary_insurance_plan": enum [HMO, PPO, EPO, POS],
        "primary_insurance_coverage": [health, vision, dental, etc]
        "secondary_insurance": bool,
        "secondary_insurance_source": enum,
        "secondary_insurance_plan": enum,
        "secondary_insurance_converage": enum,
      }
    },
  "encounters" : [{
    "id": str,
    "attributes": enum ["attended", "missed", "scheduled"]
    "scheduled_date": datetime,
    "actual_date": datetime | None,
    "type": str (routine, non-routine, emergency),
    "provider" : str (PCP, NP, labs, endcrinologist, dietician, etc),
    "tests_performed": [str],
    "orders" : ["medications" : [{}], "procedures" : [{}], "tests" : [{}], "referrals" : [{}]]
    "procedures": [str],
    "diagnoses": [str],
    "follow_up": {
      "recommended": bool,
      "scheduled_encounter_id": str | None
    }
  }],
  "measurements": [{}] ##things that can be expected to fluctuate over time
  "events": [{}] #events that have a definite beginning and may have an ending, may arise from measurement changes, other events, patient attributes, or randomly
  }
}
